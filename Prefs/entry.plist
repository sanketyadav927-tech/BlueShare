<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  entry.plist — tells PreferenceLoader how to show BlueShare in Settings.
  Install path: /Library/PreferenceBundles/BlueSharePrefs.bundle/entry.plist
-->
<plist version="1.0">
<dict>
    <key>entry</key>
    <dict>
        <key>bundle</key>
        <string>BlueSharePrefs</string>
        <key>cell</key>
        <string>PSLinkCell</string>
        <key>detail</key>
        <string>BSPrefsListController</string>
        <key>icon</key>
        <string>icon.png</string>
        <key>isController</key>
        <true/>
        <key>label</key>
        <string>BlueShare</string>
    </dict>
</dict>
</plist>
